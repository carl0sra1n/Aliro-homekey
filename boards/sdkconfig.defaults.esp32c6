# Board: ESP32-C6 with PN532 over SPI + TTLock via 4N25 optocoupler
# Target: idf.py set-target esp32c6

CONFIG_IDF_TARGET="esp32c6"

# PN532 SPI pinout
CONFIG_ALIRO_NFC_SPI_CS=5
CONFIG_ALIRO_NFC_SPI_SCK=18
CONFIG_ALIRO_NFC_SPI_MISO=19
CONFIG_ALIRO_NFC_SPI_MOSI=23

# Lock output GPIO (4N25 optocoupler trigger for TTLock K1/K2)
CONFIG_ALIRO_LOCK_GPIO=4
CONFIG_ALIRO_LOCK_ACTIVE_LOW=n
CONFIG_ALIRO_LOCK_UNLOCK_MS=1000

CONFIG_ALIRO_NFC_ECP_BEACON=n

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
