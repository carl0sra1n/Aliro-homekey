# Board: ESP32-C6 with PN532 over SPI + TTLock via 4N25 optocoupler
# Target: idf.py set-target esp32c6

CONFIG_IDF_TARGET="esp32c6"

# PN532 SPI pinout
CONFIG_ALIRO_NFC_SPI_CS=5
CONFIG_ALIRO_NFC_SPI_SCK=18
CONFIG_ALIRO_NFC_SPI_MISO=19
CONFIG_ALIRO_NFC_SPI_MOSI=23

# Lock output GPIO (4N25 optocoupler trigger for TTLock K1/K2)
CONFIG_ALIRO_LOCK_GPIO=4
CONFIG_ALIRO_LOCK_ACTIVE_LOW=n
CONFIG_ALIRO_LOCK_UNLOCK_MS=1000

CONFIG_ALIRO_NFC_ECP_BEACON=n

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# --- Code size optimizations to fit 1.875 MB OTA slot on RISC-V ---
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=n
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n

# Strip informational logs in production to save ~70 KB flash
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=n
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LWIP_STATS=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
